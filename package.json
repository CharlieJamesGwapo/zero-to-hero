{
  "name": "zero-to-hero",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css}' 'content/**/*.mdx' 'tests/**/*.ts' 'mdx-components.tsx' 'next.config.ts' 'README.md' 'CONTRIBUTING.md' 'CODE_OF_CONDUCT.md' 'docs/**/*.md' '.github/**/*.{md,yml}'"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.6",
    "@types/mdx": "^2.0.14",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
